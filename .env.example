# ─── Discord ────────────────────────────────────────────────────────────────
# Sacá estos tres valores de https://discord.com/developers/applications
#   1. Creá una aplicación y llamala AriBuilder.
#   2. Pestaña "Bot"    -> Reset Token -> copiá el token acá abajo.
#   3. Pestaña "OAuth2" -> copiá Client ID y Client Secret.
#   4. En "OAuth2 -> Redirects" añadí exactamente la URL de tu instancia + la
#      ruta de callback. En local:
#      http://localhost:3000/api/auth/callback/discord
#      Y en producción, la misma ruta sobre tu dominio, por ejemplo:
#      https://aribuilder.tudominio.com/api/auth/callback/discord
#
# El bot se pone el nombre "AriBuilder" solo al arrancar y lo mantiene en cada
# servidor donde entra, así que no hace falta que lo configures a mano.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Web ────────────────────────────────────────────────────────────────────
# Generá uno con:  npx auth secret     (o:  openssl rand -base64 32)
AUTH_SECRET=
# La URL pública desde la que se entra. Tiene que coincidir con el Redirect de
# arriba, o el login de Discord fallará con "redirect_uri mismatch".
AUTH_URL=http://localhost:3000

# ─── Base de datos ──────────────────────────────────────────────────────────
# El provider de Prisma se deduce de esta URL (ver scripts/proveedor-db.mjs):
#   file:...        -> SQLite,  para desarrollo en tu máquina.
#   postgresql://   -> Postgres, para una instancia pública de verdad.
DATABASE_URL="file:./dev.db"

# Solo lo usa docker-compose.yml, para la contraseña de su Postgres.
# Poné cualquier cosa larga y aleatoria:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── Generación con IA ──────────────────────────────────────────────────────
# TODAVÍA NO SE USA: la generación de plantillas con IA está prevista para una
# fase futura. Podés dejarlo vacío.
ANTHROPIC_API_KEY=
