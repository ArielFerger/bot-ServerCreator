// El `provider` lo ajusta `scripts/proveedor-db.mjs` a partir de DATABASE_URL
// (Prisma no acepta env() aquí), así que no hace falta editarlo a mano: SQLite
// en local, Postgres en la instancia pública. No hay nada específico de una ni
// de otra en el resto del esquema.
datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// ─── Auth.js ────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  plantillas    Template[]
  ejecuciones   ApplyRun[]
  createdAt     DateTime   @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── AriBuilder ─────────────────────────────────────────────────────────────

model Template {
  id          String     @id @default(cuid())
  ownerId     String
  nombre      String
  descripcion String     @default("")
  emoji       String?
  /// La plantilla completa, serializada. La fuente de verdad de su forma es el
  /// esquema Zod de @aribuilder/core, no esta columna.
  json        String
  esPublica   Boolean    @default(false)
  /// Si nació de la galería, de una importación o de la IA.
  origen      String     @default("editor")
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ejecuciones ApplyRun[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId])
}

/// Una aplicación de una plantilla a un servidor. Guarda los IDs de todo lo que
/// creó para que "Deshacer" borre exactamente eso y nada más.
model ApplyRun {
  id         String    @id @default(cuid())
  templateId String?
  userId     String
  guildId    String
  guildName  String    @default("")
  modo       String    @default("fusionar")
  /// pendiente | aplicando | completado | con-fallos | deshecho | error
  estado     String    @default("pendiente")
  fallos     Int       @default(0)
  /// Creados (ver @aribuilder/applier), serializado. Es lo que consume "Deshacer".
  creados    String    @default("{}")
  /// Registro de eventos para poder enseñar qué pasó.
  log        String    @default("[]")
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([guildId])
}

/// Paneles de auto-rol publicados. Los lee el bot de gateway para saber qué rol
/// dar cuando alguien pulsa un botón.
model AutoRolePanel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  messageId String   @unique
  /// [{ id, nombre }] de los roles que ofrece el panel.
  roles     String
  createdAt DateTime @default(now())

  @@index([guildId])
}
